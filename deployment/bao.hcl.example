ui = false
disable_mlock = true
listener "tcp" {
  address = "0.0.0.0:8200"
  tls_cert_file = "/tls/bao.crt"
  tls_key_file = "/tls/bao.key"
  tls_min_version = "tls12"
}
storage "raft" { path = "/state" node_id = "governance-bao-1" }
api_addr = "https://openbao:8200"
cluster_addr = "https://openbao:8201"
